<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="mb-8">
    <%= link_to "← Back to Entries", entries_path, class: "text-white hover:text-indigo-200 transition-colors" %>
    <% if @entry.feed %>
      <%= link_to "← Back to #{@entry.feed.name}", feed_path(@entry.feed), class: "text-white hover:text-indigo-200 transition-colors ml-2" %>
    <% end %>
  </div>

  <div class="bg-white/90 backdrop-blur-sm rounded-xl shadow-xl overflow-hidden">
    <div class="bg-gradient-to-r from-indigo-500 to-pink-500 h-2"></div>
    <div class="p-8">

    <% if @entry.image.attached? %>
      <div class="mb-6">
        <%= image_tag @entry.image, class: "w-full h-auto rounded-lg shadow-md" %>
      </div>
    <% end %>
    

      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-800 mb-2"><%= @entry.title %></h1>
          <div class="text-sm text-gray-500">
            <% if @entry.feed %>
              <%= link_to @entry.feed.name, feed_path(@entry.feed), class: "font-medium text-indigo-600 hover:text-indigo-800" %> • 
            <% end %>
            Published: <%= @entry.published_at.strftime("%B %d, %Y at %I:%M %p") %>
            <% if @entry.author.present? %>
              by <span class="text-gray-700"><%= @entry.author %></span>
            <% end %>
          </div>
        </div>
        
        <% if @entry.url.present? %>
          <%= link_to "View Original", @entry.url, target: "_blank", rel: "noopener", 
              class: "px-4 py-2 border border-indigo-600 text-indigo-600 rounded-lg hover:bg-indigo-50 transition-colors" %>
        <% end %>
      </div>

      <div class="prose max-w-none text-gray-700">
        <%= sanitize @entry.content %>
      </div>
    </div>
  </div>
</div>
