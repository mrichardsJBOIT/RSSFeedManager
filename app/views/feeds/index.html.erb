<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="mb-8 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-white">Your Feeds</h1>
    <%= link_to "New Feed", new_feed_path, 
        class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" %>
  </div>

  <% if @feeds.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @feeds.each do |feed| %>
        <div class="bg-white/90 backdrop-blur-sm rounded-xl shadow-xl overflow-hidden transition-all hover:shadow-2xl hover:-translate-y-1">
          <div class="bg-gradient-to-r from-indigo-500 to-pink-500 h-2"></div>
          <div class="p-6">
            <div class="flex justify-between items-start">
              <h3 class="text-xl font-semibold text-gray-800">
                <%= link_to feed.name, feed_path(feed), class: "hover:text-indigo-600 transition-colors" %>
              </h3>
              <div class="flex space-x-2">
                <%= link_to "Edit", edit_feed_path(feed), 
                    class: "text-sm px-3 py-1 border border-indigo-600 text-indigo-600 rounded-lg hover:bg-indigo-50 transition-colors" %>
                <%= button_to "Delete", feed_path(feed), method: :delete, 
                    class: "text-sm px-3 py-1 border border-red-600 text-red-600 rounded-lg hover:bg-red-50 transition-colors", 
                    data: { turbo_confirm: "Are you sure?" } %>
              </div>
            </div>
            
            <% if feed.url.present? %>
              <div class="mt-2 text-sm text-gray-500 truncate">
                <%= link_to feed.url, feed.url, target: "_blank", rel: "noopener", 
                    class: "hover:text-indigo-600 transition-colors" %>
              </div>
            <% end %>
            
            <div class="mt-4 text-sm text-gray-500">
              Last fetched: <%= feed.last_fetched_at ? feed.last_fetched_at.strftime("%B %d, %Y") : "Never" %>
            </div>
            
            <div class="mt-4">
              <%= link_to "View Entries (#{feed.entries.count})", feed_entries_path(feed), 
                  class: "text-sm px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white/90 backdrop-blur-sm rounded-xl p-8 text-center">
      <p class="text-gray-500">No feeds yet.</p>
      <%= link_to "Add your first feed", new_feed_path, 
          class: "mt-4 inline-block px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" %>
    </div>
  <% end %>
</div>
