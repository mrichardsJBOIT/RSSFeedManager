# encoding: utf-8
<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-8">
    <%= link_to "� Back to Feed", feed_path(@feed), class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">Edit Feed</h1>
  
  <div class="bg-white rounded-lg shadow-md p-6">
    <%= form_with(model: @feed, local: true) do |form| %>
      <% if @feed.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <h2 class="font-bold"><%= pluralize(@feed.errors.count, "error") %> prohibited this feed from being saved:</h2>
          <ul class="list-disc list-inside">
            <% @feed.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= form.label :name, class: "block text-gray-700 font-medium mb-2" %>
        <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-4">
        <%= form.label :url, class: "block text-gray-700 font-medium mb-2" %>
        <%= form.url_field :url, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        <p class="text-sm text-gray-500 mt-1">Enter the full URL of the RSS feed</p>
      </div>

      <div class="mb-6">
        <%= form.label :description, class: "block text-gray-700 font-medium mb-2" %>
        <%= form.text_area :description, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="flex justify-end">
        <%= form.submit "Update Feed", class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>